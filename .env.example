DB_URL=jdbc:mysql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/sadari?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:///path/to/truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit&rewriteBatchedStatements=true
DB_USERNAME=your-db-user
DB_PASSWORD=change-me
DB_CONNECTION_TIMEOUT=60000
DB_MAXIMUM_POOL_SIZE=5
DB_MINIMUM_IDLE=1

STORAGE_PROVIDER=s3
STORAGE_LOCAL_ROOT=C:/shared/sadari-uploads
STORAGE_S3_BUCKET=your-private-bucket-name
STORAGE_S3_REGION=ap-northeast-2
STORAGE_S3_ENDPOINT=
STORAGE_S3_PATH_STYLE_ACCESS=false
AWS_ACCESS_KEY_ID=replace-with-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-iam-secret-access-key

MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=20MB
