<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.sadari.admin.sadariadmin.schedulelog.mapper.ScheduleLogMapper">
    <!-- 스케줄러 실행 결과 공통 조회 컬럼 목록 -->
    <sql id="scheduleLogColumns">
          RUNX_NUMB
        , SCHD_CODE
        , METH_NAME
        , EXEC_STAT
        , STRT_DATE
        , FNSH_DATE
        , TRGT_CNTT
        , SUCC_CNTT
        , FAIL_CNTT
        , EXEC_MSEC
    </sql>

    <!-- 스케줄러 실행 결과 목록을 최신 실행 순서로 조회한다 -->
    <select id="getScheduleLogList" resultType="org.sadari.admin.sadariadmin.schedulelog.vo.ScheduleLogVO">
        SELECT /* getScheduleLogList */
               <include refid="scheduleLogColumns"/>
          FROM TL_SCLOGX
      ORDER BY RUNX_NUMB DESC
    </select>

    <!-- 스케줄러 실행 번호로 실행 결과 단건을 조회한다 -->
    <select id="getScheduleLogDtl" resultType="org.sadari.admin.sadariadmin.schedulelog.vo.ScheduleLogVO">
        SELECT /* getScheduleLogDtl */
               <include refid="scheduleLogColumns"/>
          FROM TL_SCLOGX
         WHERE RUNX_NUMB = #{runxNumb}
    </select>

    <!-- 선택한 스케줄러 실행에 연결된 실패 상세 목록을 실패 순번으로 조회한다 -->
    <select id="getScheduleFailList" resultType="org.sadari.admin.sadariadmin.schedulelog.vo.ScheduleFailVO">
        SELECT /* getScheduleFailList */
               RUNX_NUMB
             , FAIL_NUMB
             , FAIL_TYPE
             , RSLT_CODE
             , RSLT_MESG
             , ERRO_TYPE
             , ERRO_CNTN
             , FAIL_DATE
          FROM TL_SCFAIL
         WHERE RUNX_NUMB = #{runxNumb}
      ORDER BY FAIL_NUMB
    </select>
</mapper>
